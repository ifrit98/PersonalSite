---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Button from '@/components/ui/Button.astro';
import Envelope from '@/components/ui/Envelope.astro';
import { SIGNATURE_SYSTEMS } from '@/lib/systems';
// PRD §§14–18, 50: case studies follow one proof-led skeleton.
const signature = [
  { id: 'real-time-underwater-detection', name: 'Real-Time Underwater Detection', problem: 'Operational underwater detection that had to work outside lab conditions.', constraints: 'Operational noise, simulation-to-real transfer, and sub-50 ms Jetson inference.', contribution: 'Led the hybrid DSP + ML architecture, simulation workflow, and edge deployment path.', outcome: 'Sub-50 ms operational inference on embedded hardware' },
  { id: 'secure-distributed-ml', name: 'Secure Distributed ML Infrastructure', problem: 'Enable distributed LLM work in disconnected, approval-heavy environments.', constraints: 'Air-gapped operations, classified handling, and strict artifact approval.', contribution: 'Built the training, deployment, and operator workflow capability.', outcome: 'Distributed fine-tuning operational across an air-gapped multi-GPU cluster', href: '/work/secure-ml-architecture' },
  { id: 'adversarial-storage-incentives', name: 'Adversarial Storage & Incentives', problem: 'Make continued ciphertext storage provable rather than trusted.', constraints: 'Adversarial participants, anti-precompute mechanics, and long-horizon incentives.', contribution: 'Architected challenge design, verification, reputation, and incentive alignment.', outcome: 'Operated in production under continuous integrity proofs', href: '/work/adversarial-storage-protocol' },
  { id: 'turnkeyhq', name: 'TurnkeyHQ', problem: 'Turn an ambiguous vertical-AI thesis into an operable multi-tenant system.', constraints: 'Tenant isolation, bounded model behavior, release evidence, and commercial controls.', contribution: 'Co-founded and carried the product through architecture, implementation, operations, and controls.', outcome: '14 services · 244 API routes · 75 agent skills · private beta', href: '/turnkeyhq' },
] as const;
const envelopeFor = (id: string) => {
  const system = SIGNATURE_SYSTEMS.find((s) => s.id === id);
  if (!system) throw new Error(`no envelope for /work#${id}`);
  return system;
};
const contributions = [
  ['Architecture under ambiguity', 'Establish system boundaries, state, interfaces, constraints, failure modes, and the smallest architecture capable of proving the idea.'],
  ['Critical-path engineering', 'Build or lead implementation of the components whose behavior actually determines whether the system works.'],
  ['Technical strategy and de-risking', 'Translate architecture into evidence: benchmarks, threat models, observability, deployment boundaries, economics, rollback, and falsifiable decision criteria.'],
] as const;
const additional = [['Agentic Data','/agentic-data'],['SwarmOS','/swarmos'],['Capability Commons','/capability-commons']] as const;
// Secondary case studies without their own page render here, so the
// /work#rf-classification and /work#structure-lab links used across the site
// land on something (PRD §33 keeps Structure Lab as a Work case study).
const secondaryAnchors: Record<string, string> = {
  'rf-classification-streaming-ml': 'rf-classification',
  'structure-lab': 'structure-lab',
};
const secondary = (await getCollection('work', (entry) => entry.id in secondaryAnchors))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ anchor: secondaryAnchors[entry.id], ...entry.data }));
---
<BaseLayout title="Selected Systems Work" description="Real-time ML at the edge, secure distributed training, adversarial protocols, and a multi-tenant AI platform.">
  <section class="hero">
    <div class="container">
      <h1>Selected systems work</h1>
      <div class="hero__body">
        <p>I work on architecture-heavy technical problems where failure has a concrete cost: latency, security, reliability, adversarial behavior, operational complexity, or a system that simply does not survive contact with its users.</p>
        <p>My role is usually to define the system, build the critical path, and make the important constraints explicit enough that the architecture can be tested rather than merely discussed.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Signature case studies</h2>
      <div class="cases">
        {signature.map((item) => (
          <article class="case" id={item.id}>
            <div class="case__text">
              <h3>{item.name}</h3>
              <dl>
                <div><dt>Problem</dt><dd>{item.problem}</dd></div>
                <div><dt>Constraints</dt><dd>{item.constraints}</dd></div>
                <div><dt>Architectural contribution</dt><dd>{item.contribution}</dd></div>
                <div><dt>Outcome</dt><dd>{item.outcome}</dd></div>
              </dl>
              {'href' in item && <a class="case__link" href={item.href}>Read the case study</a>}
            </div>
            <Envelope systems={[envelopeFor(item.id)]} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Additional systems</h2>
      <div class="secondary">
        {secondary.map((item) => (
          <article id={item.anchor}>
            <h3>{item.title}</h3>
            <p class="secondary__meta">{item.role}{item.year && ` · ${item.year}`}</p>
            <p>{item.summary}</p>
          </article>
        ))}
      </div>
      <p class="additional">Also: {additional.map(([name, href], i) => <>{i > 0 && ', '}<a href={href}>{name}</a></>)}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How I contribute</h2>
      <div class="three">
        {contributions.map(([h, b]) => <article><h3>{h}</h3><p>{b}</p></article>)}
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="container container--narrow">
      <h2>Best-fit problems</h2>
      <p>I am most useful when the architecture is not yet obvious, several technical or operational domains interact, incorrect assumptions become expensive later, or the system must survive real users, real infrastructure, or adversarial behavior.</p>
      <p>If you already have a clean specification and simply need commodity implementation capacity, I may not be the highest-leverage fit.</p>
      <p>Most of this work is bought as a bounded engagement: an architecture and risk review, a de-risking sprint, or ongoing fractional principal architecture.</p>
      <div class="dark__action"><Button href="/engage" variant="brass">See engagement types</Button></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero,
  .section,
  .dark {
    padding-block: var(--sp-20);
    border-bottom: 1px solid var(--color-line);
  }

  .hero__body {
    max-width: 44em;
  }

  .hero p {
    margin-top: var(--sp-5);
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-slate);
  }

  h2 {
    margin-bottom: var(--sp-8);
  }

  .case {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--sp-12);
    align-items: start;
    padding-block: var(--sp-10);
    border-top: 1px solid var(--color-line);
    scroll-margin-top: 6rem;
  }

  .case:first-child {
    border-top-color: var(--color-ink);
  }

  .case h3 {
    font-size: 1.625rem;
  }

  .case dl {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }

  .case dt {
    font: var(--text-meta);
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-ink);
  }

  .case dd {
    margin-top: var(--sp-1);
    color: var(--color-slate);
  }

  .case__link,
  .additional a {
    color: var(--color-brass-text);
    font-weight: 500;
  }

  .case__link {
    display: inline-block;
    margin-top: var(--sp-6);
  }

  .secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-8);
  }

  .secondary article {
    padding-top: var(--sp-5);
    border-top: 1px solid var(--color-ink);
    scroll-margin-top: 6rem;
  }

  .secondary p {
    margin-top: var(--sp-3);
    color: var(--color-slate);
  }

  .secondary .secondary__meta {
    margin-top: var(--sp-2);
    font: var(--text-meta);
    font-family: var(--font-sans);
  }

  .additional {
    margin-top: var(--sp-10);
    color: var(--color-slate);
  }

  .three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-8);
  }

  .three article {
    padding-top: var(--sp-5);
    border-top: 1px solid var(--color-ink);
  }

  .three p {
    margin-top: var(--sp-3);
    color: var(--color-slate);
  }

  .dark {
    background: var(--color-dark-surface);
    --color-brass-text: var(--color-brass);
  }

  .dark h2 {
    color: var(--color-dark-text);
    margin-bottom: 0;
  }

  .dark p {
    margin-top: var(--sp-5);
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-dark-muted);
  }

  .dark__action {
    margin-top: var(--sp-8);
  }

  @media (max-width: 900px) {
    .case {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-8);
    }
  }

  @media (max-width: 768px) {
    .hero,
    .section,
    .dark {
      padding-block: var(--sp-14);
    }

    .secondary,
    .three {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
