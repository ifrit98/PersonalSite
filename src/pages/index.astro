---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import {
  SITE,
  AFTERFIAT_PROFILE_URL,
  ESCHATOLOGY_URL,
  ENDORSED_PROPERTIES,
  CONTACT_URL,
} from '@/lib/site';

const proofItems = [
  { text: '0→1 product ownership', href: '/turnkeyhq' },
  { text: '<50ms edge inference on Jetson', href: '/work#real-time-underwater-detection' },
  { text: '128-GPU air-gapped fine-tuning', href: '/work#secure-distributed-ml' },
  { text: '~$60M protocol revenue in production', href: '/work#adversarial-storage-incentives' },
  { text: '315-test retrieval platform', href: '/agentic-data' },
  { text: '358-page versioned thesis', href: '/afterfiat' },
] as const;

const operatingRange = [
  {
    title: 'Products & platforms',
    body: 'From market thesis and architecture through release, operation, and iteration.',
    examples: 'Vertical AI · Retrieval · Knowledge systems',
  },
  {
    title: 'Secure systems',
    body: 'Machine learning, protocols, and infrastructure built for adversarial constraints.',
    examples: 'Air-gapped ML · Edge inference · Verification',
  },
  {
    title: 'Research & synthesis',
    body: 'Formal arguments and public frameworks that make complex systems legible.',
    examples: 'Monetary systems · Institutions · Mathematical form',
  },
] as const;

const serviceCards = [
  {
    title: 'Product & Platform Delivery',
    body: 'Market thesis, product architecture, application and data layers, integrations, release infrastructure, and production operations.',
  },
  {
    title: 'Protocol Design & Monetary Architecture',
    body: 'Threat models, mechanism design, verification-heavy systems, and structures built for strategic environments.',
  },
  {
    title: 'Knowledge Systems & Retrieval',
    body: 'Retrieval systems, context graphs, schemas, and teach-forward platforms that turn information into action.',
  },
] as const;

const caseStudies = [
  {
    category: 'Flagship / Vertical AI',
    title: 'TurnkeyHQ',
    body: 'A multi-tenant AI operating system carried from product thesis through engineering, deployment, tenant operations, and commercial lifecycle.',
    metric: '14 services · 9 images · 171 migrations · 75 agent skills',
    href: '/turnkeyhq',
  },
  {
    category: 'Infrastructure / Protocol',
    title: 'Adversarial Storage & Incentives',
    body: 'Ciphertext-only storage network with ongoing proofs, long-horizon incentives, and anti-tamper verification.',
    metric: '~$60M revenue at ~$7M avg MRR',
    href: '/work#adversarial-storage-incentives',
  },
  {
    category: 'Defense / ML',
    title: 'Real-Time Underwater Detection',
    body: 'Hybrid DSP + ML pipeline optimized for operational detection metrics and sub-50ms latency on Jetson hardware.',
    metric: '<50ms inference · ~$5M multi-year follow-on supported',
    href: '/work#real-time-underwater-detection',
  },
] as const;

const homePropertyNames = ['AfterFiat', 'Eschatology Report', 'GAMUT'];
const propertyCards = ENDORSED_PROPERTIES
  .filter((p) => homePropertyNames.includes(p.name))
  .map((p) => ({
    name: p.name,
    stage: p.tagline,
    desc: p.description,
    href: p.url,
    external: p.external,
  }));

const finalCards = [
  {
    title: 'Read the thesis',
    body: 'A versioned, falsifiable test of when privacy, proofs, and compute may support monetary premium.',
    cta: 'Read AfterFiat',
    href: AFTERFIAT_PROFILE_URL,
  },
  {
    title: 'View shipped systems',
    body: 'Case studies, operating domains, and selected outcomes under real constraints.',
    cta: 'View Work',
    href: '/work',
  },
  {
    title: 'Get in touch',
    body: 'Research collaboration, speaking, selective advisory, or an engagement.',
    cta: 'Contact',
    href: CONTACT_URL,
  },
] as const;
---

<BaseLayout description={SITE.description}>

  <!-- 1. Hero -->
  <section class="hero fade-up" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__content">
        <span class="hero__eyebrow">Founder-operator · Principal engineer · Researcher</span>
        <h1 id="hero-title" class="hero__title">I build systems from first principle to production.</h1>
        <p class="hero__body">
          My work spans AI products, secure infrastructure, verification protocols, knowledge systems,
          and formal research — usually where technical depth, operational judgment, and clear models
          have to coexist.
        </p>
        <p class="hero__thesis">
          The through-line is ownership: understand the whole problem, build the machinery, and keep it credible under pressure.
        </p>
        <div class="hero__actions">
          <Button href="#selected-work" variant="brass" data-track="hero_primary_cta_click">View Selected Work</Button>
          <Button href="/writing" variant="ghost" data-track="hero_secondary_cta_click">Read the Writing</Button>
        </div>
        <p class="hero__fit">
          The wider record includes secure ML infrastructure, real-time inference, protocol design,
          agentic retrieval, formal research, and technical leadership for high-constraint builds.
          <a href={CONTACT_URL} class="hero__fit-link" data-track="hero_engagement_link_click">Discuss an engagement →</a>
        </p>
      </div>
      <div class="hero__visual" aria-label="Operating range across products, secure systems, and research">
        <div class="range-map">
          <span class="range-map__label">Operating range</span>
          {operatingRange.map((area) => (
            <div class="range-map__area">
              <h2>{area.title}</h2>
              <p>{area.body}</p>
              <span>{area.examples}</span>
            </div>
          ))}
          <p class="range-map__throughline">Architecture · Execution · Stewardship</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Proof Strip -->
  <section class="proof fade-up" aria-label="Credentials and experience highlights">
    <div class="container">
      <ul class="proof__list">
        {proofItems.map((item, i) => (
          <li class="proof__item fade-up" style={`--stagger: ${i * 60}ms`}>
            <a href={item.href} class="proof__link" data-track="proof_item_click">{item.text}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Service Cards -->
  <section class="services fade-up" aria-labelledby="services-heading">
    <div class="container">
      <h2 id="services-heading" class="services__heading">Where the work happens</h2>
      <p class="services__intro">
        Three domains, one underlying concern: systems where the constraints are real and the wrong
        abstractions are expensive.
      </p>
      <div class="services__grid">
        {serviceCards.map((card, i) => (
          <article class="service-card fade-up" style={`--stagger: ${i * 80}ms`} data-track="service_card_click">
            <h3 class="service-card__title">{card.title}</h3>
            <p class="service-card__body">{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Selected Work -->
  <section class="work fade-up" id="selected-work" aria-labelledby="work-heading">
    <div class="container">
      <h2 id="work-heading" class="work__heading">Selected work</h2>
      <p class="work__intro">
        A few examples of the broader thesis expressed in shipped systems, operational constraints, and public infrastructure.
      </p>
      <div class="work__grid">
        {caseStudies.map((cs, i) => (
          <a href={cs.href} class="case-card fade-up" style={`--stagger: ${i * 100}ms`} data-track="case_study_click">
            <span class="case-card__category">{cs.category}</span>
            <h3 class="case-card__title">{cs.title}</h3>
            <p class="case-card__body">{cs.body}</p>
            <span class="case-card__metric">{cs.metric}</span>
            <span class="case-card__cta">Read case study <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <div class="work__more">
        <Button href="/work" variant="secondary">View All Work</Button>
      </div>
    </div>
  </section>

  <!-- 5. Engagement CTA Band -->
  <section class="engage fade-up" aria-labelledby="engage-heading">
    <div class="container container--narrow">
      <span class="engage__eyebrow">Collaboration</span>
      <h2 id="engage-heading" class="engage__title">Bring the problem, the constraints, and the desired outcome.</h2>
      <p class="engage__body">
        I take on selective work where clarity matters more than performative velocity: protocol and
        mechanism analysis, secure ML systems, retrieval and knowledge platforms, technical synthesis,
        and research collaboration.
      </p>
      <div class="engage__actions">
        <Button href={CONTACT_URL} variant="brass" data-track="engage_primary_cta_click">Get in Touch</Button>
        <Button href="/work" variant="secondary" data-track="engage_secondary_cta_click">View Work</Button>
      </div>
      <p class="engage__micro">
        Email is the fastest path. A short, concrete description beats a polished pitch.
      </p>
    </div>
  </section>

  <!-- 6. Properties with Stage Tags -->
  <section class="properties fade-up" aria-labelledby="properties-heading">
    <div class="container">
      <h2 id="properties-heading" class="properties__heading">One body of work, several public surfaces</h2>
      <p class="properties__intro">
        These properties are different surfaces of the same broader architecture: verification, capability,
        coordination, and durable value under changing conditions.
      </p>
      <div class="properties__grid">
        {propertyCards.map((prop, i) => (
          <a
            href={prop.href}
            class="prop-card fade-up"
            style={`--stagger: ${i * 80}ms`}
            data-track="property_card_click"
            target={prop.external ? '_blank' : undefined}
            rel={prop.external ? 'noopener noreferrer' : undefined}
          >
            <span class="prop-card__stage">{prop.stage}</span>
            <span class="prop-card__name">{prop.name}</span>
            <p class="prop-card__desc">{prop.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Writing CTA -->
  <section class="writing-cta fade-up" aria-labelledby="writing-heading">
    <div class="container container--narrow">
      <span class="writing-cta__eyebrow">Writing & Research</span>
      <h2 id="writing-heading" class="writing-cta__title">Follow the larger argument in public.</h2>
      <p class="writing-cta__body">
        AfterFiat asks when stress-deliverable privacy, portable proofs, and verified compute may
        support monetary premium. Eschatology Report extends the inquiry into AI, culture,
        institutions, and orientation.
      </p>
      <div class="writing-cta__actions">
        <Button href="/writing" variant="primary" data-track="writing_cta_click">Read the Writing</Button>
        <Button href={AFTERFIAT_PROFILE_URL} variant="secondary" data-track="writing_cta_afterfiat">Read AfterFiat</Button>
      </div>
      <div class="subscribe-stub" id="subscribe">
        <h3 class="subscribe-stub__title">Get major essays and project releases.</h3>
        <p class="subscribe-stub__body">Low-frequency updates on new writing, public launches, and selected research.</p>
        <form class="subscribe-stub__form" action={ESCHATOLOGY_URL} method="get" target="_blank" rel="noopener noreferrer">
          <Button variant="secondary" data-track="subscribe_click">Subscribe via Substack</Button>
        </form>
      </div>
    </div>
  </section>

  <!-- 8. Final Path Chooser -->
  <section class="paths fade-up" aria-labelledby="paths-heading">
    <div class="container">
      <h2 id="paths-heading" class="paths__heading">Start at the layer that matches your question.</h2>
      <div class="paths__grid">
        {finalCards.map((card, i) => (
          <a href={card.href} class="path-card fade-up" style={`--stagger: ${i * 100}ms`}>
            <h3 class="path-card__title">{card.title}</h3>
            <p class="path-card__body">{card.body}</p>
            <span class="path-card__cta">{card.cta} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== 1. Hero ===== */
  .hero {
    background-color: var(--color-dark-surface);
    color: var(--color-dark-text);
    padding-block: var(--sp-24) var(--sp-16);
    border-bottom: 1px solid var(--color-dark-line);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--sp-12);
    align-items: center;
  }

  .hero__eyebrow {
    display: block;
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brass);
    margin-bottom: var(--sp-4);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 1.167;
    font-weight: 500;
    color: var(--color-dark-text);
    letter-spacing: -0.01em;
    max-width: 22ch;
  }

  .hero__body {
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: rgba(232, 228, 219, 0.72);
    margin-top: var(--sp-6);
    max-width: 38em;
  }

  .hero__thesis {
    font-size: 1.1875rem;
    line-height: 1.55;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-dark-text);
    margin-top: var(--sp-6);
    max-width: 34em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--sp-8);
  }

  .hero__fit {
    font: var(--text-meta);
    font-family: var(--font-sans);
    color: var(--color-dark-muted);
    margin-top: var(--sp-6);
    max-width: 42em;
  }

  .hero__fit-link {
    color: var(--color-brass);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__fit-link:hover {
    color: var(--color-dark-text);
  }

  .hero__visual {
    display: block;
    margin-left: var(--sp-8);
  }

  .range-map {
    border: 1px solid var(--color-dark-line);
    border-top-color: rgba(169, 135, 82, 0.65);
    background: rgba(255, 255, 255, 0.025);
    padding: var(--sp-5);
    position: relative;
  }

  .range-map::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3.5rem;
    bottom: 3.5rem;
    width: 2px;
    background: var(--color-brass);
  }

  .range-map__label {
    display: block;
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    color: var(--color-brass);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--color-dark-line);
  }

  .range-map__area {
    padding: var(--sp-5) var(--sp-3);
    border-bottom: 1px solid var(--color-dark-line);
  }

  .range-map__area h2 {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.25;
    font-weight: 500;
    color: var(--color-dark-text);
    margin-bottom: var(--sp-2);
  }

  .range-map__area p {
    font: var(--text-meta);
    color: var(--color-dark-muted);
    line-height: 1.5;
  }

  .range-map__area span {
    display: block;
    margin-top: var(--sp-3);
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    color: var(--color-brass);
  }

  .range-map__throughline {
    margin-top: var(--sp-4);
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-dark-muted);
  }

  /* ===== 2. Proof Strip ===== */
  .proof {
    padding-block: var(--sp-12);
    background-color: var(--color-bone);
    background-image: linear-gradient(180deg, var(--color-warm-wash) 0%, transparent 100%);
    border-bottom: 1px solid var(--color-line);
    position: relative;
  }

  .proof::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 3rem;
    height: 2px;
    background-color: var(--color-brass);
  }

  .proof__list {
    list-style: none;
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 1024px) {
    .proof__list {
      grid-template-columns: repeat(6, 1fr);
      gap: var(--sp-6);
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .proof__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .proof__item {
    font: var(--text-meta);
    font-family: var(--font-sans);
    color: var(--color-slate);
    padding: var(--sp-3) var(--sp-4);
    border-left: 3px solid var(--color-brass);
    transition:
      background-color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .proof__item:hover {
    background-color: var(--color-warm-wash);
  }

  .proof__link {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .proof__link:hover {
    color: var(--color-ink);
  }

  /* ===== 3. Service Cards ===== */
  .services {
    padding-block: var(--sp-16);
    background-color: var(--color-bone);
    border-bottom: 1px solid var(--color-line);
  }

  .services__heading {
    font: var(--text-h2);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: var(--sp-4);
  }

  .services__intro {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    max-width: 42em;
    margin-bottom: var(--sp-8);
  }

  .services__grid {
    display: grid;
    gap: var(--sp-6);
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
  }

  @media (min-width: 640px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: var(--sp-6);
    background-color: var(--color-card-elevated);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-brass);
    box-shadow: var(--shadow-card-rest);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .service-card:hover {
    border-color: var(--color-brass);
    box-shadow: var(--shadow-card-lift);
    transform: translateY(-2px);
  }

  .service-card__title {
    font: var(--text-h3);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: var(--sp-3);
    font-size: 1.25rem;
  }

  .service-card__body {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    max-width: none;
  }

  /* ===== 4. Selected Work ===== */
  .work {
    padding-block: var(--sp-16);
    background-color: var(--color-bone);
    border-bottom: 1px solid var(--color-line);
  }

  .work__heading {
    font: var(--text-h2);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: var(--sp-4);
  }

  .work__intro {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    max-width: 42em;
    margin-bottom: var(--sp-8);
  }

  .work__grid {
    display: grid;
    gap: var(--sp-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .case-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-6);
    background-color: var(--color-card-elevated);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-card-rest);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .case-card:hover {
    border-color: var(--color-brass);
    box-shadow: var(--shadow-card-lift);
    transform: translateY(-2px);
  }

  .case-card__category {
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brass);
  }

  .case-card__title {
    font: var(--text-h3);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
    font-size: 1.25rem;
  }

  .case-card__body {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    max-width: none;
    flex: 1;
  }

  .case-card__metric {
    font: var(--text-meta);
    font-family: var(--font-mono);
    color: var(--color-ink);
    font-weight: 500;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--color-line);
  }

  .case-card__cta {
    font: var(--text-meta);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--color-brass);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-card:hover .case-card__cta {
    color: var(--color-oxblood);
  }

  .work__more {
    margin-top: var(--sp-8);
  }

  /* ===== 5. Engagement CTA Band ===== */
  .engage {
    background-color: var(--color-dark-surface);
    color: var(--color-dark-text);
    padding-block: var(--sp-24);
    border-top: 1px solid var(--color-dark-line);
    border-bottom: 1px solid var(--color-dark-line);
    text-align: center;
  }

  .engage__eyebrow {
    display: block;
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brass);
    margin-bottom: var(--sp-4);
  }

  .engage__title {
    font: var(--text-h2);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-dark-text);
    max-width: 28ch;
    margin-inline: auto;
  }

  .engage__body {
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-dark-muted);
    margin-top: var(--sp-6);
    max-width: 38em;
    margin-inline: auto;
  }

  .engage__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  .engage__micro {
    font: var(--text-meta);
    font-family: var(--font-sans);
