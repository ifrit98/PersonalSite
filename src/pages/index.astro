---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Envelope from '@/components/ui/Envelope.astro';
import { SIGNATURE_SYSTEMS } from '@/lib/systems';
import { publishedNotes } from '@/lib/notes';

// PRD §§8–13: homepage is a professional compression layer. The envelope and the
// systems table carry the proof that a stat strip and cards used to.
const steps = [
  ['Define the system', 'Turn fragmented requirements, competing assumptions, operating constraints, and failure modes into a coherent architecture and executable roadmap.'],
  ['Build the critical path', 'Prototype and implement the load-bearing components until the architecture has been tested against real software, hardware, data, users, and operational conditions.'],
  ['De-risk the system', 'Make latency, security, reliability, model behavior, cost, adversarial incentives, deployment, and recovery explicit before they become expensive production surprises.'],
] as const;
const research = [
  ['SwarmOS', 'Persistent, provenance-aware research infrastructure for coordinated agents', 'MVP operational, in active development', '/swarmos'],
  ['AfterFiat', 'A versioned, falsifiable thesis on privacy, proofs, and compute as money', 'Independent research', '/afterfiat'],
  ['Agentic Data', 'Causal, temporal, permissioned context for organizational knowledge', 'In active development', '/agentic-data'],
] as const;
const notes = (await publishedNotes()).slice(0, 3);
// The problems table's order: most common buyer problem first. The envelope keeps its own order.
const PROBLEM_ORDER = ['secure-distributed-ml', 'real-time-underwater-detection', 'turnkeyhq', 'adversarial-storage-incentives'];
const problems = PROBLEM_ORDER.map((id) => {
  const system = SIGNATURE_SYSTEMS.find((s) => s.id === id);
  if (!system) throw new Error(`no signature system ${id}`);
  return system;
});
---
<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1>I design and build AI systems that have to work under real constraints.</h1>
        <p>Private deployment, tight hardware budgets, agents that must behave, and participants with a reason to cheat. As a principal systems architect, I come in before the architecture is obvious: I help the team define the problem, then build the critical path and make the risky assumptions testable while they're still cheap to change.</p>
        <div class="hero__actions">
          <Button href="/engage">Discuss an engagement</Button>
          <a href="#problems">See the problems I work on</a>
          <a href="/papers/resume.pdf">Download résumé</a>
        </div>
      </div>
      {/* PRD: the hero leads with architecture, not the product, so TurnkeyHQ is in the table below and not here. */}
      <Envelope systems={SIGNATURE_SYSTEMS.filter((system) => system.name !== 'TurnkeyHQ')} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>The work starts before the architecture is obvious.</h2>
      <p class="intro">In these problems the constraints are real and the obvious abstraction is usually wrong. The highest-leverage engagements are usually not cleanly specified engineering tasks. They are systems problems where several constraints interact and the team needs a sharper model of the problem before adding more implementation.</p>
      <ol class="steps">
        {steps.map(([title, body], i) => (
          <li><span class="steps__n">{i + 1}</span><h3>{title}</h3><p>{body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="problems">
    <div class="container">
      <h2>Problems I'm brought in for</h2>
      <div class="table" role="table" aria-label="Problems I'm brought in for">
        <div class="table__head" role="row">
          <span role="columnheader">Problem</span><span role="columnheader">Where I've solved it</span><span role="columnheader">Outcome</span>
        </div>
        {problems.map((system) => (
          <a class="table__row" role="row" href={system.href}>
            <span role="cell" class="table__problem">{system.problem}</span>
            <span role="cell" class="table__system">{system.name}</span>
            <span role="cell" class="table__outcome">{system.outcome}</span>
          </a>
        ))}
      </div>
      <a class="section__more" href="/work">All systems work and case studies</a>
    </div>
  </section>

  <section class="dark">
    <div class="container container--narrow">
      <h2>When am I most useful?</h2>
      <p>Usually when the problem sounds something like this: “We know what outcome we need, but several systems, constraints, and stakeholders interact; the existing abstractions are breaking down; and simply adding more engineers will not tell us what the architecture should be.”</p>
      <p>That is a decision problem, not a staffing problem. Teams in it are usually better served by a bounded review of the decision than by committing another engineer for six months to a design nobody has attacked yet.</p>
      <p>Bring the problem, the constraints, and the desired outcome.</p>
      <div class="dark__action"><Button href="/engage" variant="brass">See engagement types</Button></div>
    </div>
  </section>

  <section class="introductions">
    <div class="container">
      <p>Know someone working on one of these problems? <a href="/contact?intent=introduction">Introductions are welcome.</a></p>
    </div>
  </section>

  {notes.length > 0 && (
    <section class="section" id="notes">
      <div class="container">
        <h2>Engineering notes</h2>
        <ul class="labs">
          {notes.map((note) => (
            <li><a href={`/writing/${note.id}`}><span class="labs__name">{note.data.title}</span><span class="labs__body">{note.data.excerpt}</span>{note.data.publishedAt && <time class="labs__status" datetime={note.data.publishedAt}>{note.data.publishedAt}</time>}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Independent research &amp; labs</h2>
      <p class="intro">Alongside production systems work, I maintain longer-horizon research programs in persistent machine cognition, verifiable research infrastructure, monetary architecture, optimization, and mathematical form.</p>
      <ul class="labs">
        {research.map(([name, body, status, href]) => (
          <li><a href={href}><span class="labs__name">{name}</span><span class="labs__body">{body}</span><span class="labs__status">{status}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--sp-20) var(--sp-16);
    border-bottom: 1px solid var(--color-line);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--sp-16);
    align-items: start;
  }

  .hero h1 {
    font-size: clamp(2.375rem, 4.4vw, 3.625rem);
    line-height: 1.04;
    font-stretch: 82%;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .hero p {
    margin-top: var(--sp-6);
    max-width: 36em;
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-slate);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--sp-8);
  }

  .hero__actions > a:not(.btn) {
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.3em;
  }

  .hero__actions > a:not(.btn):hover {
    text-decoration-color: var(--color-ink);
  }

  .section {
    padding-block: var(--sp-20);
    border-bottom: 1px solid var(--color-line);
  }

  .intro {
    max-width: 44em;
    margin: var(--sp-4) 0 0;
    color: var(--color-slate);
  }

  /* A real sequence, so it is numbered. */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-8);
    margin-top: var(--sp-12);
    list-style: none;
  }

  .steps li {
    padding-top: var(--sp-5);
    border-top: 2px solid var(--color-ink);
  }

  .steps__n {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .steps h3 {
    margin-top: var(--sp-2);
  }

  .steps p {
    margin-top: var(--sp-3);
    color: var(--color-slate);
  }

  .table {
    margin-top: var(--sp-8);
    border-bottom: 1px solid var(--color-line);
  }

  .table__head,
  .table__row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: var(--sp-6);
    padding-block: var(--sp-4);
    border-top: 1px solid var(--color-line);
  }

  .table__head {
    font: var(--text-meta);
    font-family: var(--font-sans);
    color: var(--color-slate);
    border-top-color: var(--color-ink);
  }

  .table__row {
    color: var(--color-ink);
    text-decoration: none;
    align-items: baseline;
  }

  .table__row:hover .table__problem {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.25em;
  }

  .table__row:hover {
    background: var(--color-warm-wash);
  }

  .table__problem {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 90%;
    font-size: 1.125rem;
  }

  .table__system {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-slate);
  }

  .table__outcome {
    color: var(--color-ink);
  }

  .section__more {
    display: inline-block;
    margin-top: var(--sp-6);
    font-weight: 500;
    color: var(--color-brass-text);
  }

  .dark {
    background: var(--color-dark-surface);
    color: var(--color-dark-text);
    --color-brass-text: var(--color-brass);
    padding-block: var(--sp-20);
  }

  .dark h2 {
    color: var(--color-dark-text);
  }

  .dark p {
    margin-top: var(--sp-5);
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-dark-muted);
    max-width: 44em;
  }

  .dark__action {
    margin-top: var(--sp-8);
  }

  .introductions {
    padding-block: var(--sp-8);
    border-bottom: 1px solid var(--color-line);
  }

  .introductions p {
    color: var(--color-slate);
  }

  .introductions a {
    color: var(--color-brass-text);
    font-weight: 500;
  }

  .labs {
    margin-top: var(--sp-8);
    list-style: none;
    border-bottom: 1px solid var(--color-line);
  }

  .labs a {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr) minmax(0, 0.9fr);
    gap: var(--sp-6);
    align-items: baseline;
    padding-block: var(--sp-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
  }

  .labs a:hover {
    background: var(--color-warm-wash);
  }

  .labs__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 90%;
    font-size: 1.125rem;
  }

  .labs__body {
    color: var(--color-slate);
  }

  .labs__status {
    font: var(--text-meta);
    font-family: var(--font-sans);
    color: var(--color-slate);
    text-align: right;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-12);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--sp-12);
    }

    .section,
    .dark {
      padding-block: var(--sp-14);
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
    }

    .table__head {
      display: none;
    }

    .table__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-1);
    }

    .labs a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-1);
    }

    .labs__status {
      text-align: left;
    }
  }
</style>
