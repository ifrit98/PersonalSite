---
import { existsSync } from 'node:fs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import {
  SSRN_URL,
  DOI_URL,
  ENGAGE_URL,
  SECURE_ML_URL,
  ADVERSARIAL_STORAGE_URL,
  AFTERFIAT_PROFILE_URL,
  CAPABILITY_COMMONS_URL,
  AGENTICDATA_URL,
  TURNKEYHQ_URL,
  ESCHATOLOGY_URL,
  GAMUT_URL,
} from '@/lib/site';

// Render the portrait only once the asset exists, so a missing file degrades to
// a text-only layout rather than a broken image.
const headshot = ['headshot.jpg', 'headshot.webp', 'headshot.png']
  .map((file) => ({ file, path: new URL(`../../public/${file}`, import.meta.url) }))
  .find(({ path }) => existsSync(path));
const headshotSrc = headshot ? `/${headshot.file}` : null;

// Citations verified against the hosted PDFs themselves and kept identical to
// /research and /resume. Both entries on this page previously carried invented
// titles, and the sonification paper was attributed to the wrong venue and year.
const publications = [
  {
    title:
      'Music Style Transformer: Music Generation via Raw Audio Transcription with Applications to Style-Transfer',
    authors: 'St. George, J., Bischof, H.P.',
    venue: "International Conference on Artificial Intelligence (ICAI '19)",
    year: 2019,
    pages: 'pp. 22–33',
    pdf: '/papers/stgeorge-music-ml-icai-2019.pdf',
  },
  {
    title: 'Sonification of Simulated Black Hole Merger Data',
    authors: 'St. George, J., Bischof, H.P., Kim, S.Y.',
    venue: "International Conference on Modeling, Simulation and Visualization Methods (MSV '18)",
    year: 2018,
    pages: 'pp. 3–9',
    pdf: '/papers/stgeorge-sonification-bridges-2019.pdf',
  },
] as const;

const timeline = [
  {
    period: '2008–2013',
    label: 'University of North Texas — B.M., Performance (Music Theory Minor)',
    detail:
      'Bachelor of Music in performance, with a minor in music theory. Counterpoint, formal analysis, and composition still shape how I approach systems architecture.',
  },
  {
    period: '2017–2019',
    label: 'Rochester Institute of Technology — M.S. Computer Science',
    detail:
      'Statistical machine learning and functional programming. Two peer-reviewed papers: transformer-based music generation from raw audio, and the sonification of black-hole merger simulations.',
  },
  {
    period: '2019–present',
    label: 'Defense ML & Secure Infrastructure',
    detail:
      'Real-time edge inference for Navy sonar systems, under 50 ms on Jetson hardware. Distributed LLM fine-tuning across an air-gapped multi-GPU cluster.',
  },
  {
    period: '2023–2025',
    label: 'Protocol & Decentralized Infrastructure',
    detail:
      'Ciphertext-only distributed storage under continuous integrity proofs, with challenge design, anti-precompute mechanics, and the incentive architecture around them.',
  },
  {
    period: '2025–present',
    label: 'Founder & Principal Engineer — Alchemical AI / TurnkeyHQ',
    detail:
      'A multi-tenant vertical AI operating system carried from product thesis through architecture, implementation, release engineering, tenant operations, and commercial controls.',
  },
  {
    period: '2025–present',
    label: 'Independent Research & Public Writing',
    detail:
      'AfterFiat on next-generation stores of value. Eschatology Report on AI, culture, and institutional drift. Agent systems, retrieval infrastructure, and knowledge architecture.',
  },
] as const;

// Every thread links to the work behind it, so the page can show the range
// instead of asserting that the range coheres.
const workOn = [
  {
    title: 'Protocols, Proofs & Incentives',
    body: 'Verification, mechanism design, and privacy-preserving systems that stay legible when participants behave strategically.',
    links: [
      { label: 'Adversarial storage', href: ADVERSARIAL_STORAGE_URL },
      { label: 'AfterFiat', href: AFTERFIAT_PROFILE_URL },
    ],
  },
  {
    title: 'ML Infrastructure & Operational Systems',
    body: 'Distributed training, secure deployment, real-time inference, and edge systems that have to survive their conditions of use.',
    links: [
      { label: 'Secure distributed ML', href: SECURE_ML_URL },
      { label: 'Real-time detection', href: '/work#real-time-underwater-detection' },
    ],
  },
  {
    title: 'Products Carried to Production',
    body: 'Multi-tenant architecture, agent and workflow infrastructure, release engineering, and the commercial controls a live system needs.',
    links: [{ label: 'TurnkeyHQ', href: TURNKEYHQ_URL }],
  },
  {
    title: 'Knowledge Architecture & Public Capability',
    body: 'Schemas, retrieval systems, and teach-forward structures that move people from information to action.',
    links: [
      { label: 'Capability Commons', href: CAPABILITY_COMMONS_URL },
      { label: 'Agentic Data', href: AGENTICDATA_URL },
    ],
  },
  {
    title: 'Writing on Money, AI & Institutions',
    body: 'Long-form work on verification, synthetic media, coordination, sovereignty, and durable value.',
    links: [
      { label: 'Writing', href: '/writing' },
      { label: 'Eschatology Report', href: ESCHATOLOGY_URL, external: true },
    ],
  },
  {
    title: 'Music, Geometry & Formal Research',
    body: 'Sound, symmetry, and lawful form — the research line I started in, and still the one I think in.',
    links: [
      { label: 'GAMUT', href: GAMUT_URL, external: true },
      { label: 'Published research', href: '/research' },
    ],
  },
] as const;
---

<BaseLayout
  title="About"
  description="About Jason St George — founder, principal engineer, and researcher building technical systems from problem definition through production."
  ogType="profile"
>
  <section class="page-hero fade-up" aria-labelledby="about-hero-title">
    <div class="container container--narrow">
      <h1 id="about-hero-title" class="page-hero__title">About</h1>
      <p class="page-hero__body">
        I'm a founder, principal engineer, and researcher. I build technical systems from problem
        definition through production, usually where the problem crosses enough boundaries that
        architecture, implementation, operations, and judgment all have to be handled by the same
        person.
      </p>
      <p class="page-hero__body">
        The work spans real-time ML at the edge, secure and distributed training infrastructure,
        adversarial protocols, agent and retrieval systems, and a multi-tenant AI product carried
        from thesis to production operations.
      </p>
    </div>
  </section>

  <section class="narrative fade-up" aria-labelledby="narrative-heading">
    <div class="container container--narrow">
      <h2 id="narrative-heading" class="section-heading">How I got here</h2>
      <div class:list={['narrative__intro', { 'narrative__intro--no-portrait': !headshotSrc }]}>
        {headshotSrc && (
          <div class="about-portrait">
            <img src={headshotSrc} alt="Jason St George" width="280" height="280" loading="eager" />
          </div>
        )}
        <div class="narrative__body">
          <p>
            I came into technical work through music. I studied performance and theory at the
            University of North Texas before moving into computer science at Rochester Institute of
            Technology. My graduate work put the two together, through machine learning, music
            generation, and scientific sonification, and produced published research on
            transformer-based music generation and the sonification of black-hole merger data.
          </p>
          <p>
            Since then the work has broadened considerably. I've built real-time detection systems
            running at the edge, distributed training infrastructure for air-gapped environments,
            storage and incentive protocols operating in production, retrieval and agent systems,
            and a multi-tenant AI product carried from initial product thesis through deployment and
            day-to-day operations.
          </p>
          <p>
            I'm most useful on problems that don't fit neatly inside one layer of the stack.
            Sometimes the difficult part is the model. Sometimes it's the protocol, the deployment
            environment, the data architecture, the release process, the incentive structure, or the
            product boundary. Often it's the interaction among several of them. That breadth is
            deliberate, though I don't think of myself as a generalist for its own sake — I like
            understanding a system well enough to identify what is actually load-bearing, and then
            following the problem wherever that leads.
          </p>
          <p>
            I'm also interested in the physical systems underneath ordinary life: power, water,
            heat, shelter, tools, repair, and the practical knowledge required to maintain them.
            Software has a way of making abstraction feel self-sufficient; physical systems are a
            useful reminder that eventually something has to work in a particular place, on a
            particular budget. Capability Commons grew out of that — good information is useful, but
            usable capability is better.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="timeline fade-up" aria-labelledby="timeline-heading">
    <div class="container container--narrow">
      <h2 id="timeline-heading" class="section-heading">Professional background</h2>
      <ol class="timeline__list">
        {timeline.map((entry, i) => (
          <li class="timeline__entry fade-up" style={`--stagger: ${i * 80}ms`}>
            <span class="timeline__period">{entry.period}</span>
            <div class="timeline__content">
              <p class="timeline__label">{entry.label}</p>
              <p class="timeline__detail">{entry.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="publications fade-up" id="published-research" aria-labelledby="publications-heading">
    <div class="container container--narrow">
      <h2 id="publications-heading" class="section-heading">Published research</h2>
      <ul class="publications__list">
        {publications.map((pub) => (
          <li class="publication">
            <p class="publication__title">{pub.title}</p>
            <p class="publication__venue">{pub.authors} · {pub.venue}, {pub.year}, {pub.pages}</p>
            <div class="publication__links">
              <a href={pub.pdf} class="publication__link">PDF</a>
            </div>
          </li>
        ))}
      </ul>
      <div class="publications__extended">
        <p class="publications__note">
          Extended thesis work:
          <a href={SSRN_URL} target="_blank" rel="noopener noreferrer">
            "Next-Generation Stores of Value" on SSRN
          </a>
          ·
          <a href={DOI_URL} target="_blank" rel="noopener noreferrer">DOI</a>
        </p>
      </div>
    </div>
  </section>

  <section class="work-on fade-up" aria-labelledby="work-on-heading">
    <div class="container">
      <h2 id="work-on-heading" class="section-heading">What I work on</h2>
      <p class="section-intro">Each thread links to the work behind it.</p>
      <div class="work-on__grid">
        {workOn.map((card, i) => (
          <article class="work-on__card fade-up" style={`--stagger: ${i * 60}ms`}>
            <h3 class="work-on__title">{card.title}</h3>
            <p class="work-on__body">{card.body}</p>
            <ul class="work-on__links">
              {card.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={'external' in link && link.external ? '_blank' : undefined}
                    rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="current-focus fade-up" aria-labelledby="focus-heading">
    <div class="container container--narrow">
      <h2 id="focus-heading" class="section-heading">Current work</h2>
      <p class="current-focus__body">
        My current work spans product and platform engineering, independent research, open technical
        infrastructure, and a small number of architecture engagements.
      </p>
      <p class="current-focus__body">
        <a href={TURNKEYHQ_URL}>TurnkeyHQ</a> is the principal product build: a multi-tenant AI
        operating system carried across product architecture, application and data layers, agent and
        workflow infrastructure, release engineering, tenant operations, and commercial controls.
        <a href={AFTERFIAT_PROFILE_URL}>AfterFiat</a> and Kardashev Labs are the main independent
        research program. Other projects explore retrieval, agent coordination, optimization,
        practical knowledge infrastructure, and formal systems.
      </p>
      <p class="current-focus__body">
        Alongside that I take a small number of outside engagements, usually where the architecture
        is still unsettled and understanding the whole system matters more than owning one narrowly
        defined piece of it. Those are described on <a href={ENGAGE_URL}>Engage</a>.
      </p>
    </div>
  </section>

  <section class="cta-band fade-up" aria-labelledby="about-cta-heading">
    <div class="container">
      <div class="cta-band__inner">
        <h2 id="about-cta-heading" class="sr-only">Where to start</h2>
        <p class="cta-band__body">
          For shipped systems and outcomes, start with Work. For professional history, the Resume.
          For independent research and active builds, Projects &amp; Labs. For essays and formal
          work, Writing.
        </p>
        <div class="cta-band__actions">
          <Button href="/work" variant="primary">View Work</Button>
          <Button href="/research" variant="secondary">Projects &amp; Labs</Button>
          <Button href="/resume" variant="secondary">Resume</Button>
          <Button href="/contact" variant="secondary">Get in Touch</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-hero {
    padding-block: var(--sp-24) var(--sp-12);
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-bone);
  }

  .page-hero__title {
    font: var(--text-h1);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
    margin-top: var(--sp-4);
  }

  .page-hero__body {
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-slate);
    margin-top: var(--sp-4);
    max-width: 38em;
  }

  .narrative {
    padding-block: var(--sp-16);
  }

  .narrative__intro {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  .narrative__intro--no-portrait {
    grid-template-columns: 1fr;
  }

  .about-portrait {
    width: 14rem;
    flex-shrink: 0;
  }

  .about-portrait img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    object-fit: cover;
    aspect-ratio: 1;
  }

  .narrative__body p {
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-ink);
    max-width: 42em;
    margin: 0;
  }

  .narrative__body p + p {
    margin-top: var(--sp-6);
  }

  /* Timeline */
  .timeline {
    padding-block: var(--sp-16);
    border-top: 1px solid var(--color-line);
  }

  .timeline__list {
    list-style: none;
    margin-top: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }

  .timeline__entry {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--sp-6);
    padding: var(--sp-5) var(--sp-5) var(--sp-5) var(--sp-6);
    border-bottom: 1px solid var(--color-line);
    border-left: 3px solid var(--color-brass);
  }

  .timeline__period {
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    color: var(--color-brass);
    padding-top: 0.15em;
    white-space: nowrap;
  }

  .timeline__label {
    font: var(--text-body);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: var(--sp-1);
    max-width: none;
  }

  .timeline__detail {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    max-width: none;
  }

  /* Publications */
  .publications {
    padding-block: var(--sp-16);
    border-top: 1px solid var(--color-line);
  }

  .publications__list {
    list-style: none;
    margin-top: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .publication {
    padding: var(--sp-5) var(--sp-5) var(--sp-5) var(--sp-6);
    border-left: 3px solid var(--color-brass);
  }

  .publication__title {
    font: var(--text-body);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: var(--sp-1);
    max-width: 44em;
  }

  .publication__venue {
    font: var(--text-meta);
    font-family: var(--font-sans);
    color: var(--color-slate);
    margin-bottom: var(--sp-2);
    max-width: none;
  }

  .publication__links {
    display: flex;
    gap: var(--sp-4);
  }

  .publication__link {
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    color: var(--color-brass);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .publication__link:hover {
    color: var(--color-oxblood);
  }

  .publications__extended {
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--color-line);
  }

  .publications__note {
    font: var(--text-meta);
    font-family: var(--font-sans);
    color: var(--color-slate);
    max-width: none;
  }

  .publications__note a {
    color: var(--color-brass);
    text-decoration: none;
  }

  .publications__note a:hover {
    color: var(--color-oxblood);
  }

  .section-heading {
    font: var(--text-h2);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
  }

  .section-intro {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    margin-top: var(--sp-4);
    max-width: 40em;
  }

  .work-on {
    padding-block: var(--sp-16);
    border-top: 1px solid var(--color-line);
  }

  .work-on__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
    grid-auto-rows: 1fr;
    margin-top: var(--sp-8);
  }

  .work-on__card {
    display: flex;
    flex-direction: column;
    background: var(--color-card-elevated);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-brass);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-rest);
    padding: var(--sp-6);
    transition:
      box-shadow var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .work-on__card:hover {
    box-shadow: var(--shadow-card-lift);
    transform: translateY(-2px);
  }

  .work-on__title {
    font: var(--text-h3);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-ink);
  }

  .work-on__body {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    margin-top: var(--sp-3);
    max-width: none;
  }

  .work-on__links {
    list-style: none;
    margin: auto 0 0;
    padding: var(--sp-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
  }

  .work-on__links a {
    font: var(--text-mono-meta);
    font-family: var(--font-mono);
    color: var(--color-brass);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .work-on__links a:hover,
  .work-on__links a:focus-visible {
    color: var(--color-oxblood);
    text-decoration: underline;
  }

  .current-focus {
    padding-block: var(--sp-16);
    border-top: 1px solid var(--color-line);
  }

  .current-focus__body {
    font: var(--text-body-lg);
    font-family: var(--font-sans);
    color: var(--color-slate);
    margin-top: var(--sp-4);
    max-width: 42em;
  }

  .current-focus__body a {
    color: var(--color-brass);
    text-decoration: none;
  }

  .current-focus__body a:hover,
  .current-focus__body a:focus-visible {
    color: var(--color-oxblood);
    text-decoration: underline;
  }

  .cta-band {
    padding-block: var(--sp-24);
    border-top: 1px solid var(--color-line);
    background-color: var(--color-warm-wash);
  }

  .cta-band__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-band__body {
    font: var(--text-body);
    font-family: var(--font-sans);
    color: var(--color-slate);
    max-width: 34em;
    text-align: center;
    margin-bottom: var(--sp-8);
  }

  .cta-band__actions {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-block: var(--sp-16) var(--sp-8);
    }

    .page-hero__title {
      font: var(--text-h2);
      font-family: var(--font-serif);
      font-weight: 500;
    }

    .narrative__intro {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: left;
    }

    .about-portrait {
      width: 10rem;
    }

    .timeline__entry {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }

    .work-on__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
