---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text' | 'brass' | 'ghost';
  class?: string;
  // id, data-track, type, target, rel… pass through to the element. They were
  // silently dropped before, which broke /resume#download and click tracking.
  [attribute: string]: unknown;
}

const { href, variant = 'primary', class: className, ...attributes } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={['btn', `btn--${variant}`, className]} data-variant={variant} {...attributes}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .btn--primary {
    padding: 0.75rem 1.5rem;
    background-color: var(--color-ink);
    color: var(--color-bone);
    border-radius: var(--radius-button);
  }

  .btn--primary:hover {
    background-color: #0B1626;
    color: var(--color-bone);
  }

  .btn--secondary {
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-button);
  }

  .btn--secondary:hover {
    border-color: var(--color-ink);
  }

  .btn--text {
    padding: 0.25rem 0;
    background: none;
    color: var(--color-brass-text);
    border-bottom: 1px solid transparent;
    min-height: 2.75rem;
  }

  .btn--text:hover {
    color: var(--color-ink);
    border-bottom-color: currentColor;
  }

  /* "brass" is the call to action on dark bands: film on ink. The ink edge keeps
     it visible where it is used on a light ground (the contact form). */
  .btn--brass {
    padding: 0.75rem 1.5rem;
    background-color: var(--color-bone);
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-button);
  }

  .btn--brass:hover {
    background-color: var(--color-white);
    color: var(--color-ink);
  }

  .btn--ghost {
    padding: 0.25rem 0;
    background: none;
    color: var(--color-dark-muted);
    border-bottom: 1px solid transparent;
    min-height: 2.75rem;
  }

  .btn--ghost:hover {
    color: var(--color-dark-text);
    border-bottom-color: currentColor;
  }

  /* brass-text is link blue on light grounds and resets to brass on dark bands,
     so the ring clears 3:1 on both. */
  .btn:focus-visible {
    outline: 2px solid var(--color-brass-text);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .btn--primary,
    .btn--secondary {
      padding: 0.875rem 1.5rem;
      min-height: 2.75rem;
    }
  }
</style>
