# Site URL for production
SITE_URL=https://jasonstgeorge.com

# Analytics (Plausible)
# PLAUSIBLE_DOMAIN=jasonstgeorge.com

# Contact inquiry notifications (Resend). Without all three, inquiries are
# stored in Supabase but nobody is emailed; the server logs a warning.
# CONTACT_NOTIFY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=re_...
CONTACT_NOTIFY_TO=jason@jasonstgeorge.com
CONTACT_NOTIFY_FROM="jasonstgeorge.com <inquiries@jasonstgeorge.com>"

# OpenAI (embeddings + chat completions)
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-5-nano

# Supabase (pgvector document store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
